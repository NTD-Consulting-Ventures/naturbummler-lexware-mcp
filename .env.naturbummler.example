# Ausschließlich Platzhalter. Reale Zugangsdaten bleiben in Railway.
NATURBUMMLER_PROFILE=true
SERVER_URL=https://RAILWAY-DOMAIN
ENTRA_TENANT_ID=
# Client-ID der bestehenden geschützten MCP-API, nicht Microsoft Graph.
ENTRA_API_AUDIENCE=
ENTRA_SCOPE=mcp.access
# Vom Auftraggeber gewünscht: wie Cargoboard, ohne zusätzliche Rollen-/Gruppenfilter.
ENTRA_ACCESS_POLICY=tenant
# Optional, falls die bestehende API eine abweichende Identifier-URI verwendet.
# ENTRA_IDENTIFIER_URI=api://API-CLIENT-ID
# Nur bei ENTRA_ACCESS_POLICY=assigned ist mindestens eine Freigabeliste erforderlich.
# Werte erst aus der bestehenden Entra-Konfiguration übernehmen.
ENTRA_ALLOWED_ROLES=
ENTRA_ALLOWED_GROUP_IDS=
LEXWARE_API_KEY=
LEXWARE_READ_ONLY=true
LEXWARE_ENABLE_DRAFTS=false
LEXWARE_ENABLE_FINALIZE=false
LEXWARE_ENABLE_URL_UPLOAD=false
LEXWARE_DEBUG_LOGGING=false
